# Caddy reverse proxy for the accessibility scanner.
# Caddy obtains and renews a Let's Encrypt TLS cert automatically.
#
# Domain: scan.auto-flow.co
# Standalone VM, dedicated to this service (not shared with pdf.auto-flow.co's
# remediation-engine, which lives on its own separate VM).
#
# Start: sudo caddy start --config /path/to/Caddyfile
# Reload after edits: sudo caddy reload --config /path/to/Caddyfile

scan.auto-flow.co {
    reverse_proxy localhost:8001
}
